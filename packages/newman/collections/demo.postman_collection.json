{
  "info": {
    "name": "Allure Newman extended demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Metadata baseline — playwright.dev",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": ["pm.environment.set('framework', 'newman');"],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('body mentions Playwright', () => pm.expect(pm.response.text()).to.include('Playwright'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": { "method": "GET", "url": "https://playwright.dev/" }
    },
    {
      "name": "Nested API — status check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('response time under 5s', () => pm.expect(pm.response.responseTime).to.be.below(5000));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": { "method": "GET", "url": "https://playwright.dev/docs/intro" }
    },
    {
      "name": "Flaky — random pass on retry",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let attempt = Number(pm.environment.get('flaky_attempt') || 0) + 1;",
              "pm.environment.set('flaky_attempt', String(attempt));",
              "const roll = Math.random();",
              "pm.environment.set('flaky_roll', String(roll));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const roll = Number(pm.environment.get('flaky_roll') || Math.random());",
              "pm.environment.set('flaky_roll', String(roll));",
              "if (roll < 0.35) {",
              "  pm.test('simulated transient failure', () => { throw new Error('Random flaky upstream (' + roll.toFixed(3) + ')'); });",
              "} else {",
              "  pm.test('recovered on lucky roll', () => pm.response.to.have.status(200));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": { "method": "GET", "url": "https://playwright.dev/" }
    },
    {
      "name": "Attachment-style headers capture",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('content-type present', () => pm.response.to.have.header('content-type'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": { "method": "GET", "url": "https://playwright.dev/" }
    },
    {
      "name": "Known failure — demo red test",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('intentional failure for Allure dashboard', () => {",
              "  pm.expect.fail('Demo failure in Newman collection');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": { "method": "GET", "url": "https://playwright.dev/" }
    }
  ]
}
