    {
      "name": "Newman · Pre-request script showcase",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generate request ID and timestamp before the request",
              "pm.variables.set('requestId', 'req-' + Math.random().toString(36).slice(2, 10));",
              "pm.variables.set('requestTimestamp', new Date().toISOString());",
              "pm.variables.set('correlationId', 'corr-' + Date.now());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// @allure.label.os:{{ALLURE_OS}}",
              "// @allure.label.framework:newman",
              "// @allure.label.feature:Pre-request scripts",
              "// @allure.label.story:Variable injection",
              "// @allure.label.epic:Framework Showcase",
              "// @allure.label.parentSuite:Newman · Postman API",
              "// @allure.label.suite:Framework Features",
              "// @allure.label.tag:framework-specific",
              "pm.test('response ok', () => pm.response.to.have.status(200));",
              "pm.test('request-id was injected', () => {",
              "  pm.expect(pm.variables.get('requestId')).to.match(/^req-/);",
              "});",
              "pm.test('correlation-id was injected', () => {",
              "  pm.expect(pm.variables.get('correlationId')).to.match(/^corr-/);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "https://playwright.dev/"
      }
    },
    {
      "name": "Newman · Response schema validation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// @allure.label.os:{{ALLURE_OS}}",
              "// @allure.label.framework:newman",
              "// @allure.label.feature:Response validation",
              "// @allure.label.story:Schema and header checks",
              "// @allure.label.epic:Framework Showcase",
              "// @allure.label.parentSuite:Newman · Postman API",
              "// @allure.label.suite:Framework Features",
              "// @allure.label.tag:framework-specific",
              "pm.test('status is 2xx', () => pm.response.to.be.success);",
              "pm.test('response time under 5s', () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(5000);",
              "});",
              "pm.test('content-type header present', () => {",
              "  pm.expect(pm.response.headers.get('content-type')).to.be.a('string');",
              "});",
              "pm.test('response body is not empty', () => {",
              "  pm.expect(pm.response.text().length).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "https://playwright.dev/"
      }
    },
    {
      "name": "Newman · Environment variable chaining",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set('sessionToken', 'tok-' + Math.random().toString(36).slice(2));",
              "pm.environment.set('userId', 'usr-' + Math.floor(Math.random() * 9000 + 1000));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// @allure.label.os:{{ALLURE_OS}}",
              "// @allure.label.framework:newman",
              "// @allure.label.feature:Variable chaining",
              "// @allure.label.story:Cross-request environment variables",
              "// @allure.label.epic:Framework Showcase",
              "// @allure.label.parentSuite:Newman · Postman API",
              "// @allure.label.suite:Framework Features",
              "// @allure.label.tag:framework-specific",
              "pm.test('session token was set', () => {",
              "  const tok = pm.environment.get('sessionToken');",
              "  pm.expect(tok).to.match(/^tok-/);",
              "});",
              "pm.test('user id was set', () => {",
              "  const uid = pm.environment.get('userId');",
              "  pm.expect(uid).to.match(/^usr-/);",
              "});",
              "pm.test('response ok', () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "https://playwright.dev/"
      }
