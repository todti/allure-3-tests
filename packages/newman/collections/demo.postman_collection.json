    {
      "name": "Payments \u2014 flaky authorization",
      "request": {
        "method": "GET",
        "url": "https://playwright.dev/"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set('pay_roll', String(Math.random()));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// @allure.label.os:{{ALLURE_OS}}",
              "// @allure.label.framework:newman",
              "const roll = Number(pm.environment.get('pay_roll'));",
              "if (roll < 0.35) { pm.test('gateway timeout', () => { throw new Error('Flaky payment ' + roll); }); }",
              "else { pm.test('authorized', () => pm.response.to.have.status(200)); }"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
